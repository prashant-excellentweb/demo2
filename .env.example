# ---------------------------------------------------------------- Environment
# "development" enables /docs and CORS for the Vite dev server.
# "production" refuses to boot with a weak SECRET_KEY or a SQLite database.
ENVIRONMENT=development

# ------------------------------------------------------------------- Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-long-random-secret-key-here
ACCESS_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------- Database
# Defaults to SQLite next to the project. Use PostgreSQL in production.
# DATABASE_URL=postgresql+psycopg://buddy:password@localhost:5432/buddy
# DATABASE_URL=sqlite:///./chatgpt.db

# ----------------------------------------------------------------- AI provider
# AI_PROVIDER: "openai" or "groq"
AI_PROVIDER=groq

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------- Limits
# Messages replayed to the model as context on each turn.
CHAT_CONTEXT_WINDOW=20
# Server-enforced daily token budget per user. Set to 0 to disable.
DAILY_TOKEN_BUDGET=200000
RESPONSE_CACHE_TTL_SECONDS=86400

# ----------------------------------------------------------------------- Misc
# Comma-separated origins allowed to send credentialed requests in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
